
@{
    var usuarioNome = Context.Session.GetString("UsuarioNome");
    var usuarioEmail = Context.Session.GetString("UsuarioEmail");
}

<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Salão Manicure
    </title>

    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        body {
            background-color: #f8f9fa;
        }

        .navbar-cliente {
            background: linear-gradient( 135deg, #8e2de2, #c471ed );
        }

        .navbar-brand {
            font-weight: 600;
        }

        .nav-link {
            color: rgba(255,255,255,.9) !important;
            transition: .2s;
        }

            .nav-link:hover {
                color: #ffffff !important;
                transform: translateY(-1px);
            }

            .nav-link.active {
                font-weight: 600;
            }

        .cliente-menu {
            border-left: 1px solid rgba(255,255,255,.3);
            padding-left: 15px;
        }

        .avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: rgba(255,255,255,.2);
            color: white;
            font-size: 20px;
        }

        .main-content {
            min-height: calc(100vh - 130px);
            padding-top: 30px;
            padding-bottom: 40px;
        }

        footer {
            background-color: #ffffff;
            border-top: 1px solid #e9ecef;
        }

    </style>

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <!-- NAVBAR -->

    <nav class="navbar navbar-expand-lg navbar-dark navbar-cliente">

        <div class="container">

            <!-- Logo -->

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-stars me-2"></i>

                Salão Manicure

            </a>


            <!-- Botão mobile -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuCliente">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- Menu -->

            <div class="collapse navbar-collapse"
                 id="menuCliente">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <!-- Início -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="bi bi-house-door me-1"></i>

                            Início

                        </a>

                    </li>


                    <!-- Agendamentos -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Agendamentos"
                           asp-action="Index">

                            <i class="bi bi-calendar-check me-1"></i>

                            Meus Agendamentos

                        </a>

                    </li>


                    <!-- Novo agendamento -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Agendamentos"
                           asp-action="Cadastrar">

                            <i class="bi bi-calendar-plus me-1"></i>

                            Agendar

                        </a>

                    </li>

                </ul>


                <!-- Usuário -->

                <ul class="navbar-nav">

                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle d-flex align-items-center"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown">

                            <span class="avatar me-2">

                                <i class="bi bi-person"></i>

                            </span>

                            <span>
                                @(string.IsNullOrWhiteSpace(usuarioNome)
                                                                ? "Minha conta"
                                                                : usuarioNome)
                            </span>
                        </a>


                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li>
                                <h6 class="dropdown-header">
                                    <i class="bi bi-person-circle me-1"></i>
                                    Minha conta
                                </h6>
                            </li>

                            <li>
                                <span class="dropdown-item-text small text-muted">
                                    @usuarioEmail
                                </span>
                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>


                            <!-- Perfil -->

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Cliente"
                                   asp-action="Editar">
                                    <i class="bi bi-person-vcard me-2"></i>
                                    Meu Perfil
                                </a>
                            </li>
                            <!-- Agendamentos -->
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Agendamentos"
                                   asp-action="Index">
                                    <i class="bi bi-calendar-check me-2"></i>
                                    Meus Agendamentos
                                </a>
                            </li>
                            <li>
                                <hr class="dropdown-divider" />
                            </li>
                            <!-- Sair -->
                            <li>
                                <a class="dropdown-item text-danger"
                                   asp-controller="Auth"
                                   asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Sair
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- CONTEÚDO -->

    <main class="main-content">

        <div class="container">

            @if (TempData["MensagemSucesso"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">

                    <i class="bi bi-check-circle me-2"></i>

                    @TempData["MensagemSucesso"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }

            @if (TempData["MensagemErro"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">

                    <i class="bi bi-exclamation-circle me-2"></i>

                    @TempData["MensagemErro"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }

            @RenderBody()

        </div>
    </main>


    <!-- FOOTER -->

    <footer class="py-4">

        <div class="container">

            <div class="row">

                <div class="col-md-6">

                    <strong>
                        <i class="bi bi-stars me-1"></i>
                        Salão Manicure
                    </strong>

                    <p class="text-muted mb-0 mt-1">
                        Sua beleza, seu momento.
                    </p>

                </div>

                <div class="col-md-6 text-md-end">

                    <small class="text-muted">

                        &copy; @DateTime.Now.Year
                        Salão Manicure

                    </small>

                </div>

            </div>

        </div>

    </footer>


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>

