<!DOCTYPE html>

<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    
    <title>@ViewData["Title"] - Sistema Manicure</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            margin: 0;
            background-color: #f5f6fa;
        }

        .admin-wrapper {
            min-height: 100vh;
        }

        /* MENU LATERAL */

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background-color: #212529;
            color: white;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
        }

        .sidebar-header {
            height: 70px;
            display: flex;
            align-items: center;
            padding: 0 20px;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }

            .sidebar-header h4 {
                margin: 0;
            }

        .sidebar-menu {
            padding: 20px 10px;
        }

            .sidebar-menu .nav-link {
                color: #adb5bd;
                padding: 12px 15px;
                margin-bottom: 5px;
                border-radius: 6px;
            }

                .sidebar-menu .nav-link:hover {
                    background-color: #343a40;
                    color: white;
                }

                .sidebar-menu .nav-link.active {
                    background-color: #0d6efd;
                    color: white;
                }

            .sidebar-menu i {
                width: 25px;
            }

        /* CONTEÚDO */

        .main-content {
            margin-left: 250px;
            min-height: 100vh;
        }

        .topbar {
            height: 70px;
            background-color: white;
            border-bottom: 1px solid #dee2e6;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }

        .content {
            padding: 30px;
        }

    </style>
    

</head>

<body>

    <div class="admin-wrapper">

        <!-- MENU LATERAL -->

        <aside class="sidebar">

            <div class="sidebar-header">

                <i class="bi bi-gem fs-4 me-2"></i>

                <h4>Manicure</h4>

            </div>

            <nav class="sidebar-menu">

                <ul class="nav flex-column">

                    <!-- Dashboard -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="bi bi-speedometer2"></i>

                            Dashboard

                        </a>

                    </li>


                    <!-- Agendamentos -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Agendamentos"
                           asp-action="Index">

                            <i class="bi bi-calendar-event"></i>

                            Agendamentos

                        </a>

                    </li>
                    <!-- Disponibilidade -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Disponibilidades"
                           asp-action="Index">

                            <i class="bi bi-calendar-check"></i>

                            Disponibilidades

                        </a>

                    </li>

                    <!-- Clientes -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Clientes"
                           asp-action="Index">

                            <i class="bi bi-people"></i>

                            Clientes

                        </a>

                    </li>


                    <!-- Profissionais -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Profissionais"
                           asp-action="Index">

                            <i class="bi bi-person-badge"></i>

                            Profissionais

                        </a>

                    </li>


                    <!-- Serviços -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Servicos"
                           asp-action="Index">

                            <i class="bi bi-scissors"></i>

                            Serviços

                        </a>

                    </li>


                    <hr />


                    <!-- Usuários -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Usuarios"
                           asp-action="Index">

                            <i class="bi bi-person-gear"></i>

                            Usuários

                        </a>

                    </li>


                    <!-- Configurações -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Configuracoes"
                           asp-action="Index">

                            <i class="bi bi-gear"></i>

                            Configurações

                        </a>

                    </li>


                    <hr />


                    <!-- Sair -->

                    <li class="nav-item">

                        <a class="nav-link text-danger"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="bi bi-box-arrow-right"></i>

                            Sair

                        </a>

                    </li>

                </ul>

            </nav>

        </aside>


        <!-- ÁREA PRINCIPAL -->

        <main class="main-content">

            <!-- TOPBAR -->

            <header class="topbar">

                <div>

                    <button class="btn btn-light d-md-none">

                        <i class="bi bi-list"></i>

                    </button>

                </div>

                <div class="d-flex align-items-center">

                    <i class="bi bi-person-circle fs-4 me-2"></i>

                    <span>Administrador</span>

                </div>

            </header>


            <!-- CONTEÚDO -->

            <div class="content">

                @RenderBody()

            </div>

        </main>

    </div>


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    

</body>

</html>
