
@model List<SalaoManicure.Models.Profissional>

@{
    ViewData["Title"] = "Profissionais";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Profissionais</h2>

            <p class="text-muted mb-0">
                Gerencie as profissionais cadastradas no sistema.
            </p>
        </div>

        <a asp-action="Cadastrar" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i>
            Nova Profissional
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                <i class="bi bi-people me-2"></i>
                Lista de Profissionais
            </h5>

        </div>

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>E-mail</th>
                                <th>Telefone</th>
                                <th>Status</th>
                                <th class="text-end">Ações</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var profissional in Model)
                            {
                                <tr>

                                    <td>
                                        @profissional.Id
                                    </td>

                                    <td>
                                        <strong>
                                            @profissional.Nome
                                        </strong>
                                    </td>

                                    <td>
                                        @profissional.Email
                                    </td>

                                    <td>
                                        @profissional.Telefone
                                    </td>

                                    <td>

                                        @if (profissional.Ativo)
                                        {
                                            <span class="badge bg-success">
                                                Ativo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inativo
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Editar"
                                           asp-route-id="@profissional.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-pencil"></i>
                                            Editar

                                        </a>

                                        <a asp-action="Excluir"
                                           asp-route-id="@profissional.Id"
                                           class="btn btn-sm btn-outline-danger">

                                            <i class="bi bi-trash"></i>
                                            Excluir

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center p-5">

                    <i class="bi bi-person-x fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        Nenhuma profissional cadastrada
                    </h5>

                    <p class="text-muted">
                        Cadastre a primeira profissional para começar.
                    </p>

                    <a asp-action="Cadastrar"
                       class="btn btn-primary">

                        <i class="bi bi-person-plus me-1"></i>
                        Cadastrar Profissional

                    </a>

                </div>
            }

        </div>

    </div>

</div>

