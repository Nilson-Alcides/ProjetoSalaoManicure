
@model SalaoManicure.Models.Profissional

@{
    ViewData["Title"] = "Editar Profissional";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="mb-1">
                Editar Profissional
            </h2>

            <p class="text-muted mb-0">
                Altere os dados da profissional.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Voltar

        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                <i class="bi bi-pencil-square me-2"></i>

                Dados da Profissional

            </h5>

        </div>

        <div class="card-body">

            <form asp-action="Editar" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Nome"
                               class="form-label">
                            Nome
                        </label>

                        <input asp-for="Nome"
                               class="form-control"
                               placeholder="Digite o nome da profissional" />

                        <span asp-validation-for="Nome"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label">
                            E-mail
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="Digite o e-mail" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Telefone"
                               class="form-label">
                            Telefone
                        </label>

                        <input asp-for="Telefone"
                               class="form-control"
                               placeholder="(11) 99999-9999" />

                        <span asp-validation-for="Telefone"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Status
                        </label>

                        <div class="form-check form-switch mt-2">

                            <input asp-for="Ativo"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="Ativo"
                                   class="form-check-label">
                                Profissional ativa
                            </label>

                        </div>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle me-1"></i>
                        Salvar Alterações

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}

