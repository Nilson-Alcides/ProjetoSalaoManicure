
@model SalaoManicure.Models.Bloqueio

@{
    ViewData["Title"] = "Editar Bloqueio";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-pencil-square text-primary"></i>
                Editar Bloqueio
            </h2>

            <p class="text-muted mb-0">
                Altere os dados do bloqueio.
            </p>
        </div>

        <a asp-controller="Bloqueios"
           asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Voltar

        </a>

    </div>


    <!-- Formulário -->
    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">
                Dados do bloqueio
            </h5>
        </div>

        <div class="card-body">

            <form asp-controller="Bloqueios"
                  asp-action="Editar"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- Profissional -->
                <div class="mb-3">

                    <label asp-for="ProfissionalId"
                           class="form-label">
                        Profissional
                    </label>

                    <select asp-for="ProfissionalId"
                            class="form-select">

                        <option value="0">
                            Selecione um profissional
                        </option>

                        @foreach (var profissional in ViewBag.Profissionais)
                        {
                            <option value="@profissional.Id">
                                @profissional.Nome
                            </option>
                        }

                    </select>

                    <span asp-validation-for="ProfissionalId"
                          class="text-danger">
                    </span>

                </div>


                <!-- Data -->
                <div class="mb-3">

                    <label asp-for="Data"
                           class="form-label">
                        Data
                    </label>

                    <input asp-for="Data"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="Data"
                          class="text-danger">
                    </span>

                </div>


                <!-- Horário -->
                <div class="mb-3">

                    <label asp-for="Horario"
                           class="form-label">
                        Horário
                    </label>

                    <input asp-for="Horario"
                           type="time"
                           class="form-control" />

                    <div class="form-text">

                        <i class="bi bi-info-circle"></i>

                        Deixe o horário vazio para bloquear o
                        <strong>dia inteiro</strong>.

                    </div>

                    <span asp-validation-for="Horario"
                          class="text-danger">
                    </span>

                </div>


                <!-- Motivo -->
                <div class="mb-3">

                    <label asp-for="Motivo"
                           class="form-label">
                        Motivo
                    </label>

                    <textarea asp-for="Motivo"
                              class="form-control"
                              rows="3"
                              placeholder="Ex.: Férias, compromisso pessoal, feriado...">
                    </textarea>

                    <span asp-validation-for="Motivo"
                          class="text-danger">
                    </span>

                </div>


                <!-- Status -->
                <div class="form-check form-switch mb-4">

                    <input asp-for="Ativo"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="Ativo"
                           class="form-check-label">
                        Bloqueio ativo
                    </label>

                </div>


                <!-- Botões -->
                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="Bloqueios"
                       asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle"></i>
                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg"></i>
                        Salvar Alterações

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

