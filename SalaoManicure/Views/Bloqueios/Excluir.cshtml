
@model SalaoManicure.Models.Bloqueio

@{
    ViewData["Title"] = "Excluir Bloqueio";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-trash text-danger"></i>
                Excluir Bloqueio
            </h2>

            <p class="text-muted mb-0">
                Confirme a exclusão deste bloqueio.
            </p>
        </div>

        <a asp-controller="Bloqueios"
           asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Voltar

        </a>

    </div>


    <!-- Aviso -->
    <div class="alert alert-warning">

        <i class="bi bi-exclamation-triangle"></i>

        <strong>Atenção!</strong>

        Esta ação não poderá ser desfeita.
        Deseja realmente excluir este bloqueio?

    </div>


    <!-- Dados do bloqueio -->
    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">
                Dados do bloqueio
            </h5>
        </div>

        <div class="card-body">

            <dl class="row mb-0">

                <!-- ID -->
                <dt class="col-sm-3">
                    ID
                </dt>

                <dd class="col-sm-9">
                    @Model.Id
                </dd>


                <!-- Profissional -->
                <dt class="col-sm-3">
                    Profissional
                </dt>

                <dd class="col-sm-9">
                    @(Model.Profissional?.Nome ?? "Não informado")
                </dd>


                <!-- Data -->
                <dt class="col-sm-3">
                    Data
                </dt>

                <dd class="col-sm-9">
                    @Model.Data.ToString("dd/MM/yyyy")
                </dd>


                <!-- Horário -->
                <dt class="col-sm-3">
                    Horário
                </dt>

                <dd class="col-sm-9">

                    @if (Model.Horario.HasValue)
                    {
                        <span class="badge bg-warning text-dark">
                            @Model.Horario.Value.ToString(@"hh\:mm")
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Dia inteiro
                        </span>
                    }

                </dd>


                <!-- Motivo -->
                <dt class="col-sm-3">
                    Motivo
                </dt>

                <dd class="col-sm-9">

                    @if (!string.IsNullOrWhiteSpace(Model.Motivo))
                    {
                        @Model.Motivo
                    }
                    else
                    {
                        <span class="text-muted">
                            Não informado
                        </span>
                    }

                </dd>


                <!-- Status -->
                <dt class="col-sm-3">
                    Status
                </dt>

                <dd class="col-sm-9">

                    @if (Model.Ativo)
                    {
                        <span class="badge bg-success">
                            Ativo
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Inativo
                        </span>
                    }

                </dd>

            </dl>

        </div>


        <!-- Botões -->
        <div class="card-footer d-flex justify-content-end gap-2">

            <a asp-controller="Bloqueios"
               asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-x-circle"></i>
                Cancelar

            </a>


            <form asp-controller="Bloqueios"
                  asp-action="Excluir"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-danger">

                    <i class="bi bi-trash"></i>
                    Confirmar Exclusão

                </button>

            </form>

        </div>

    </div>

</div>

