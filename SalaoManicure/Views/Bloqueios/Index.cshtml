
@model List<SalaoManicure.Models.Bloqueio>

@{
    ViewData["Title"] = "Bloqueios";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-calendar-x text-danger"></i>
                Bloqueios
            </h2>

            <p class="text-muted mb-0">
                Gerencie os dias e horários em que os profissionais não estarão disponíveis.
            </p>
        </div>

        <a asp-controller="Bloqueios"
           asp-action="Cadastrar"
           class="btn btn-primary">

            <i class="bi bi-plus-lg"></i>
            Novo Bloqueio

        </a>

    </div>


    <!-- Tabela -->
    <div class="card shadow-sm">

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>ID</th>
                                <th>Profissional</th>
                                <th>Data</th>
                                <th>Horário</th>
                                <th>Motivo</th>
                                <th>Status</th>
                                <th class="text-end">Ações</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var bloqueio in Model)
                            {
                                <tr>

                                    <td>
                                        @bloqueio.Id
                                    </td>

                                    <td>
                                        <strong>
                                            @(bloqueio.Profissional?.Nome ?? "Não informado")
                                        </strong>
                                    </td>

                                    <td>
                                        @bloqueio.Data.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>

                                        @if (bloqueio.Horario.HasValue)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @bloqueio.Horario.Value.ToString(@"hh\:mm")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Dia inteiro
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(bloqueio.Motivo))
                                        {
                                            @bloqueio.Motivo
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Não informado
                                            </span>
                                        }
                                    </td>

                                    <td>

                                        @if (bloqueio.Ativo)
                                        {
                                            <span class="badge bg-success">
                                                Ativo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inativo
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a asp-controller="Bloqueios"
                                           asp-action="Editar"
                                           asp-route-id="@bloqueio.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Editar">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        <a asp-controller="Bloqueios"
                                           asp-action="Excluir"
                                           asp-route-id="@bloqueio.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Excluir">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Estado vazio -->

                <div class="text-center py-5">

                    <i class="bi bi-calendar-x display-4 text-muted"></i>

                    <h5 class="mt-3">
                        Nenhum bloqueio cadastrado
                    </h5>

                    <p class="text-muted">
                        Cadastre um bloqueio para impedir agendamentos em um dia ou horário específico.
                    </p>

                    <a asp-controller="Bloqueios"
                       asp-action="Cadastrar"
                       class="btn btn-primary">

                        <i class="bi bi-plus-lg"></i>
                        Cadastrar Bloqueio

                    </a>

                </div>
            }

        </div>

    </div>

</div>

