
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login - Salão Manicure</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        body {
            min-height: 100vh;
            background: #f8f5f7;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-container {
            width: 100%;
            max-width: 420px;
            padding: 20px;
        }

        .login-card {
            background: white;
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
            padding: 35px;
        }

        .logo {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: #f1d7e3;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            color: #a23b68;
            font-size: 30px;
        }

        .login-title {
            text-align: center;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .login-subtitle {
            text-align: center;
            color: #777;
            margin-bottom: 30px;
        }

        .form-control {
            padding: 12px;
            border-radius: 10px;
        }

        .btn-login {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            background: #a23b68;
            border: none;
            color: white;
            font-weight: 600;
        }

            .btn-login:hover {
                background: #8d3059;
                color: white;
            }

        .register-link {
            text-align: center;
            margin-top: 20px;
        }
    </style>
</head>

<body>

    <div class="login-container">

        <div class="login-card">

            <!-- Ícone -->
            <div class="logo">
                <i class="bi bi-person"></i>
            </div>

            <!-- Título -->
            <h3 class="login-title">
                Bem-vindo!
            </h3>

            <p class="login-subtitle">
                Entre na sua conta para continuar
            </p>

            <!-- Mensagem de erro -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <!-- Formulário -->
            <form asp-controller="Auth"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- E-mail -->
                <div class="mb-3">

                    <label class="form-label">
                        E-mail
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-envelope"></i>
                        </span>

                        <input type="email"
                               name="email"
                               class="form-control"
                               placeholder="Digite seu e-mail"
                               autocomplete="email"
                               required />

                    </div>

                </div>

                <!-- Senha -->
                <div class="mb-3">

                    <label class="form-label">
                        Senha
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-lock"></i>
                        </span>

                        <input type="password"
                               name="senha"
                               class="form-control"
                               placeholder="Digite sua senha"
                               autocomplete="current-password"
                               required />

                    </div>

                </div>

                <!-- Botão -->
                <button type="submit"
                        class="btn btn-login">

                    <i class="bi bi-box-arrow-in-right"></i>
                    Entrar

                </button>

            </form>

            <!-- Cadastro -->
            <div class="register-link">

                <span class="text-muted">
                    Ainda não possui uma conta?
                </span>

                <br />

                <a asp-controller="Auth"
                   asp-action="Registrar"
                   class="text-decoration-none">

                    Criar minha conta

                </a>

            </div>

        </div>

    </div>

</body>
</html>

