
@model List<SalaoManicure.Models.Disponibilidade>

@{
    ViewData["Title"] = "Disponibilidades";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-calendar-week"></i>
                Disponibilidades
            </h2>

            <p class="text-muted mb-0">
                Horários disponíveis dos profissionais.
            </p>
        </div>

        <a asp-action="Cadastrar"
           class="btn btn-primary">

            <i class="bi bi-plus-circle"></i>
            Nova Disponibilidade

        </a>

    </div>


    <!-- CARD -->
    <div class="card shadow-sm">

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>ID</th>

                                <th>
                                    Profissional
                                </th>

                                <th>
                                    Data
                                </th>

                                <th>
                                    Horário
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end">
                                    Ações
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var disponibilidade in Model)
                            {
                                <tr>

                                    <!-- ID -->
                                    <td>
                                        @disponibilidade.Id
                                    </td>


                                    <!-- PROFISSIONAL -->
                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="bg-primary bg-opacity-10
                                                                rounded-circle
                                                                p-2 me-2">

                                                <i class="bi bi-person text-primary">
                                                </i>

                                            </div>

                                            <span>
                                                @disponibilidade.Profissional?.Nome
                                            </span>

                                        </div>

                                    </td>


                                    <!-- DATA -->
                                    <td>

                                        <i class="bi bi-calendar3 me-1"></i>

                                        @disponibilidade.Data.ToString("dd/MM/yyyy")

                                    </td>


                                    <!-- HORÁRIO -->
                                    <td>

                                        <span class="badge bg-light text-dark border">

                                            <i class="bi bi-clock me-1"></i>

                                            @disponibilidade.Horario.ToString(@"hh\:mm")

                                        </span>

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        @if (disponibilidade.Ativo)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle me-1"></i>
                                                Ativo

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                <i class="bi bi-x-circle me-1"></i>
                                                Inativo

                                            </span>
                                        }

                                    </td>


                                    <!-- AÇÕES -->
                                    <td class="text-end">

                                        <div class="btn-group"
                                             role="group">

                                            <a asp-action="Editar"
                                               asp-route-id="@disponibilidade.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            <a asp-action="Excluir"
                                               asp-route-id="@disponibilidade.Id"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Excluir">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- ESTADO VAZIO -->

                <div class="text-center py-5">

                    <i class="bi bi-calendar-x display-4 text-muted">
                    </i>

                    <h5 class="mt-3">
                        Nenhuma disponibilidade cadastrada
                    </h5>

                    <p class="text-muted">
                        Cadastre os dias e horários em que os profissionais
                        estarão disponíveis para atendimento.
                    </p>

                    <a asp-action="Cadastrar"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle"></i>
                        Cadastrar disponibilidade

                    </a>

                </div>
            }

        </div>

    </div>

</div>

