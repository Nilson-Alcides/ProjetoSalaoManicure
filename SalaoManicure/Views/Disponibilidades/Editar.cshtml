
@model SalaoManicure.Models.Disponibilidade

@{
    ViewData["Title"] = "Alterar Disponibilidade";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-pencil-square"></i>
                Alterar Disponibilidade
            </h2>

            <p class="text-muted mb-0">
                Altere a data, horário ou profissional da disponibilidade.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Voltar
        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Editar" method="post">

                @Html.AntiForgeryToken()

                <!-- ID -->
                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">

                    <!-- PROFISSIONAL -->
                    <div class="col-md-6">

                        <label asp-for="ProfissionalId"
                               class="form-label">
                            Profissional
                        </label>

                        <select asp-for="ProfissionalId"
                                class="form-select">

                            <option value="0">
                                Selecione um profissional
                            </option>

                            @foreach (var profissional in ViewBag.Profissionais)
                            {
                                <option value="@profissional.Id">
                                    @profissional.Nome
                                </option>
                            }

                        </select>

                        <span asp-validation-for="ProfissionalId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- DATA -->
                    <div class="col-md-3">

                        <label asp-for="Data"
                               class="form-label">
                            Data
                        </label>

                        <input asp-for="Data"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Data"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- HORÁRIO -->
                    <div class="col-md-3">

                        <label asp-for="Horario"
                               class="form-label">
                            Horário
                        </label>

                        <input asp-for="Horario"
                               type="time"
                               class="form-control" />

                        <span asp-validation-for="Horario"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ATIVO -->
                    <div class="col-12">

                        <div class="form-check form-switch">

                            <input asp-for="Ativo"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="Ativo"
                                   class="form-check-label">
                                Disponibilidade ativa
                            </label>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- BOTÕES -->
                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-x-circle"></i>
                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle"></i>
                        Salvar Alterações

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}

