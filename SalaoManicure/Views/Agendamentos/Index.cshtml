
@model List<SalaoManicure.Models.Agendamento>

@{
    ViewData["Title"] = "Agendamentos";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-calendar-check text-primary"></i>
                Agendamentos
            </h2>

            <p class="text-muted mb-0">
                Gerencie os agendamentos dos clientes.
            </p>
        </div>

        <a asp-controller="Agendamentos"
           asp-action="Cadastrar"
           class="btn btn-primary">

            <i class="bi bi-plus-lg"></i>
            Novo Agendamento

        </a>

    </div>


    <!-- Tabela -->
    <div class="card shadow-sm">

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>ID</th>

                                <th>Data</th>

                                <th>Horário</th>

                                <th>Cliente</th>

                                <th>Profissional</th>

                                <th>Serviço</th>

                                <th>Status</th>

                                <th class="text-end">
                                    Ações
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var agendamento in Model)
                            {
                                <tr>

                                    <!-- ID -->
                                    <td>
                                        @agendamento.Id
                                    </td>


                                    <!-- Data -->
                                    <td>
                                        @agendamento.Data.ToString("dd/MM/yyyy")
                                    </td>


                                    <!-- Horário -->
                                    <td>
                                        <span class="badge bg-primary">
                                            @agendamento.Horario.ToString(@"hh\:mm")
                                        </span>
                                    </td>


                                    <!-- Cliente -->
                                    <td>

                                        <strong>
                                            @(agendamento.Cliente?.Nome
                                                                                ?? "Não informado")
                                                                                               </strong>

                                    </td>


                                    <!-- Profissional -->
                                    <td>
                                        @(agendamento.Profissional?.Nome
                                                                        ?? "Não informado")
                                                                                       </td>


                                    <!-- Serviço -->
                                    <td>
                                        @(agendamento.Servico?.Nome
                                                                        ?? "Não informado")
                            </td>


                                    <!-- Status -->
                                    <td>

                                @switch (agendamento.Status)
                                        {
                                            case "Agendado":

                                                <span class="badge bg-primary">
                                                    Agendado
                                                </span>

                                                break;

                                            case "Confirmado":

                                                <span class="badge bg-success">
                                                    Confirmado
                                                </span>

                                                break;

                                            case "Cancelado":

                                                <span class="badge bg-danger">
                                                    Cancelado
                                                </span>

                                                break;

                                            case "Concluído":

                                                <span class="badge bg-secondary">
                                                    Concluído
                                                </span>

                                                break;

                                            default:

                                                <span class="badge bg-warning text-dark">
                                                    @agendamento.Status
                                                </span>

                                                break;
                                        }

                                    </td>


                                    <!-- Ações -->
                                    <td class="text-end">

                                        <a asp-controller="Agendamentos"
                                           asp-action="Editar"
                                           asp-route-id="@agendamento.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Editar">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        <a asp-controller="Agendamentos"
                                           asp-action="Excluir"
                                           asp-route-id="@agendamento.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Excluir">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Estado vazio -->

                <div class="text-center py-5">

                    <i class="bi bi-calendar-x display-4 text-muted"></i>

                    <h5 class="mt-3">
                        Nenhum agendamento cadastrado
                    </h5>

                    <p class="text-muted">
                        Cadastre um novo agendamento para começar.
                    </p>

                    <a asp-controller="Agendamentos"
                       asp-action="Cadastrar"
                       class="btn btn-primary">

                        <i class="bi bi-plus-lg"></i>
                        Cadastrar Agendamento

                    </a>

                </div>
            }

        </div>

    </div>

</div>
