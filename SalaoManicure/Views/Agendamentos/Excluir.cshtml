
@model SalaoManicure.Models.Agendamento

@{
    ViewData["Title"] = "Excluir Agendamento";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">
                <i class="bi bi-calendar-x"></i>
                Excluir Agendamento
            </h2>

            <p class="text-muted mb-0">
                Confirme a exclusão do agendamento abaixo.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Voltar
        </a>
    </div>

    <!-- Alerta -->
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i>
        <strong>Atenção!</strong>
        Esta ação não poderá ser desfeita.
    </div>

    <!-- Dados do agendamento -->
    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">
                Dados do Agendamento
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <!-- Cliente -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">
                        Cliente
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.Cliente?.Nome"
                           readonly />
                </div>

                <!-- Profissional -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">
                        Profissional
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.Profissional?.Nome"
                           readonly />
                </div>

                <!-- Serviço -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">
                        Serviço
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.Servico?.Nome"
                           readonly />
                </div>

                <!-- Data -->
                <div class="col-md-3">
                    <label class="form-label fw-bold">
                        Data
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.Data.ToString("dd/MM/yyyy")"
                           readonly />
                </div>

                <!-- Horário -->
                <div class="col-md-3">
                    <label class="form-label fw-bold">
                        Horário
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.Horario.ToString(@"hh\:mm")"
                           readonly />
                </div>

                <!-- Status -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">
                        Status
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.Status"
                           readonly />
                </div>

            </div>

        </div>

        <!-- Rodapé -->
        <div class="card-footer d-flex justify-content-end gap-2">

            <a asp-action="Index"
               class="btn btn-secondary">
                <i class="bi bi-x-circle"></i>
                Cancelar
            </a>

            <form asp-action="Excluir"
                  method="post"
                  class="d-inline">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-danger"
                        onclick="return confirm('Tem certeza que deseja excluir este agendamento?');">

                    <i class="bi bi-trash"></i>
                    Confirmar Exclusão

                </button>

            </form>

        </div>

    </div>

</div>
