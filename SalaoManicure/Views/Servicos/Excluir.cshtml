
@model SalaoManicure.Models.Servico

@{
    ViewData["Title"] = "Excluir Serviço";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="mb-1">
                Excluir Serviço
            </h2>

            <p class="text-muted mb-0">
                Confirme a exclusão do serviço.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Voltar

        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0 text-danger">

                <i class="bi bi-exclamation-triangle me-2"></i>
                Confirmar Exclusão

            </h5>

        </div>

        <div class="card-body">

            <div class="alert alert-warning">

                <i class="bi bi-exclamation-triangle me-2"></i>

                <strong>Atenção!</strong>

                Esta ação irá excluir permanentemente
                este serviço do sistema.

            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-bold">
                        ID
                    </label>

                    <div class="form-control bg-light">
                        @Model.Id
                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-bold">
                        Nome
                    </label>

                    <div class="form-control bg-light">
                        @Model.Nome
                    </div>

                </div>

                <div class="col-md-8 mb-3">

                    <label class="form-label fw-bold">
                        Descrição
                    </label>

                    <div class="form-control bg-light">
                        @(string.IsNullOrWhiteSpace(Model.Descricao)
                                                ? "Não informado"
                                                : Model.Descricao)
                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <label class="form-label fw-bold">
                        Preço
                    </label>

                    <div class="form-control bg-light">
                        @Model.Preco.ToString("C2")
                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-bold">
                        Duração
                    </label>

                    <div class="form-control bg-light">
                        @Model.DuracaoMinutos minutos
                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-bold">
                        Status
                    </label>

                    <div>

                        @if (Model.Ativo)
                        {
                            <span class="badge bg-success">
                                Ativo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inativo
                            </span>
                        }

                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <form asp-action="Excluir"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash me-1"></i>
                        Confirmar Exclusão

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

