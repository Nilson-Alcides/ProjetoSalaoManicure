
@model SalaoManicure.Models.Servico

@{
    ViewData["Title"] = "Cadastrar Serviço";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="mb-1">
                Cadastrar Serviço
            </h2>

            <p class="text-muted mb-0">
                Cadastre um novo serviço oferecido pelo salão.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Voltar

        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                <i class="bi bi-scissors me-2"></i>
                Dados do Serviço

            </h5>

        </div>

        <div class="card-body">

            <form asp-action="Cadastrar" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Nome"
                               class="form-label">
                            Nome do Serviço
                        </label>

                        <input asp-for="Nome"
                               class="form-control"
                               placeholder="Ex.: Manicure" />

                        <span asp-validation-for="Nome"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Preco"
                               class="form-label">
                            Preço
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                R$
                            </span>

                            <input asp-for="Preco"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   placeholder="0,00" />

                        </div>

                        <span asp-validation-for="Preco"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-8 mb-3">

                        <label asp-for="Descricao"
                               class="form-label">
                            Descrição
                        </label>

                        <textarea asp-for="Descricao"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Descreva o serviço">
                        </textarea>

                        <span asp-validation-for="Descricao"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="DuracaoMinutos"
                               class="form-label">
                            Duração
                        </label>

                        <div class="input-group">

                            <input asp-for="DuracaoMinutos"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="Ex.: 60" />

                            <span class="input-group-text">
                                minutos
                            </span>

                        </div>

                        <span asp-validation-for="DuracaoMinutos"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-12 mb-3">

                        <label class="form-label">
                            Status
                        </label>

                        <div class="form-check form-switch">

                            <input asp-for="Ativo"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="Ativo"
                                   class="form-check-label">
                                Serviço ativo
                            </label>

                        </div>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle me-1"></i>
                        Cadastrar

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}

