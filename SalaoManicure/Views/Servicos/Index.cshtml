
@model List<SalaoManicure.Models.Servico>

@{
    ViewData["Title"] = "Serviços";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Serviços</h2>

            <p class="text-muted mb-0">
                Gerencie os serviços oferecidos pelo salão.
            </p>
        </div>

        <a asp-action="Cadastrar" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Novo Serviço
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                <i class="bi bi-scissors me-2"></i>
                Lista de Serviços
            </h5>

        </div>

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>ID</th>
                                <th>Serviço</th>
                                <th>Descrição</th>
                                <th>Preço</th>
                                <th>Duração</th>
                                <th>Status</th>
                                <th class="text-end">Ações</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var servico in Model)
                            {
                                <tr>

                                    <td>
                                        @servico.Id
                                    </td>

                                    <td>
                                        <strong>
                                            @servico.Nome
                                        </strong>
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(servico.Descricao))
                                        {
                                            <span class="text-muted">
                                                Não informado
                                            </span>
                                        }
                                        else
                                        {
                                            @servico.Descricao
                                        }
                                    </td>

                                    <td>
                                        @servico.Preco.ToString("C2")
                                    </td>

                                    <td>
                                        @servico.DuracaoMinutos min
                                    </td>

                                    <td>

                                        @if (servico.Ativo)
                                        {
                                            <span class="badge bg-success">
                                                Ativo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inativo
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Editar"
                                           asp-route-id="@servico.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-pencil"></i>
                                            Editar

                                        </a>

                                        <a asp-action="Excluir"
                                           asp-route-id="@servico.Id"
                                           class="btn btn-sm btn-outline-danger">

                                            <i class="bi bi-trash"></i>
                                            Excluir

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center p-5">

                    <i class="bi bi-scissors fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        Nenhum serviço cadastrado
                    </h5>

                    <p class="text-muted">
                        Cadastre o primeiro serviço para começar.
                    </p>

                    <a asp-action="Cadastrar"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i>
                        Cadastrar Serviço

                    </a>

                </div>
            }

        </div>

    </div>

</div>

