@model SalaoManicure.Models.Cliente

@{
    ViewData["Title"] = "Cadastrar Cliente";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">

    ```
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Cadastrar Cliente</h2>
            <p class="text-muted mb-0">
                Cadastre um novo cliente no sistema.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Voltar
        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="bi bi-person-plus me-2"></i>
                Dados do Cliente
            </h5>
        </div>


        <div class="card-body">

            <form asp-action="Cadastrar" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <div class="row">

                    <!-- Nome -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Nome" class="form-label">
                            Nome
                        </label>

                        <input asp-for="Nome"
                               class="form-control"
                               placeholder="Digite o nome do cliente" />

                        <span asp-validation-for="Nome"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- E-mail -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Email" class="form-label">
                            E-mail
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="Digite o e-mail" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Telefone -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Telefone" class="form-label">
                            Telefone
                        </label>

                        <input asp-for="Telefone"
                               class="form-control"
                               placeholder="(11) 99999-9999" />

                        <span asp-validation-for="Telefone"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <hr class="my-4" />


                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle me-1"></i>
                        Cadastrar

                    </button>

                </div>

            </form>

        </div>

    </div>
    ```

</div>

@section Scripts {

    ```
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    ```

}
