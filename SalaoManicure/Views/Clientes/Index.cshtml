@model List<SalaoManicure.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
    Layout = "_LayoutAdmin";
}

<div class="container mt-4">

    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Clientes</h2>
            <p class="text-muted mb-0">
                Lista de clientes cadastrados
            </p>
        </div>

        <a asp-action="Cadastrar" class="btn btn-primary">
            <i class="bi bi-person-plus"></i>
            Novo Cliente
        </a>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-white">
            <strong>Clientes cadastrados</strong>
        </div>

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover table-bordered align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>E-mail</th>
                                <th>Telefone</th>
                                <th>Data de Cadastro</th>
                                <th class="text-center" style="width: 180px;">
                                    Ações
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var cliente in Model)
                            {
                                <tr>

                                    <td>
                                        @cliente.Id
                                    </td>

                                    <td>
                                        <strong>@cliente.Nome</strong>
                                    </td>

                                    <td>
                                        @cliente.Email
                                    </td>

                                    <td>
                                        @cliente.Telefone
                                    </td>

                                    <td>
                                        @cliente.DataCadastro.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td class="text-center">

                                        <a asp-action="Editar"
                                           asp-route-id="@cliente.Id"
                                           class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i>
                                            Editar
                                        </a>

                                        <a asp-action="Excluir"
                                           asp-route-id="@cliente.Id"
                                           class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i>
                                            Excluir
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5 class="text-muted">
                        Nenhum cliente cadastrado.
                    </h5>

                    <p class="text-muted">
                        Clique em "Novo Cliente" para cadastrar o primeiro cliente.
                    </p>

                    <a asp-action="Cadastrar" class="btn btn-primary">
                        Novo Cliente
                    </a>

                </div>
            }

        </div>

    </div>
    

</div>
