@model SalaoManicure.Models.Agendamento

@{
    ViewData["Title"] = "Confirmação do Pagamento";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";

    var pagamento = Model.Pagamento;
    var statusPagamento = pagamento?.Status?.ToLower() ?? "pendente";

    bool aprovado = statusPagamento == "aprovado"
                 || statusPagamento == "approved"
                 || statusPagamento == "pago";

    bool falhou = statusPagamento == "falha"
               || statusPagamento == "rejeitado"
               || statusPagamento == "cancelado";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5 text-center">

                    @if (aprovado)
                    {
                        <i class="bi bi-check-circle-fill text-success"
                           style="font-size: 4rem;"></i>

                        <h2 class="mt-3 text-success">
                            Pagamento confirmado!
                        </h2>

                        <p class="text-muted">
                            Seu pagamento foi aprovado. Seu agendamento
                            está confirmado.
                        </p>
                    }
                    else if (falhou)
                    {
                        <i class="bi bi-x-circle-fill text-danger"
                           style="font-size: 4rem;"></i>

                        <h2 class="mt-3 text-danger">
                            Pagamento não aprovado
                        </h2>

                        <p class="text-muted">
                            Não identificamos a aprovação do pagamento.
                            Consulte seu agendamento para verificar as
                            próximas etapas.
                        </p>
                    }
                    else
                    {
                        <i class="bi bi-clock-history text-warning"
                           style="font-size: 4rem;"></i>

                        <h2 class="mt-3">
                            Pagamento em processamento
                        </h2>

                        <p class="text-muted">
                            Recebemos seu retorno do Mercado Pago.
                            Estamos aguardando a confirmação definitiva.
                        </p>
                    }

                    <hr class="my-4" />

                    <h5 class="text-start mb-3">
                        Detalhes do agendamento
                    </h5>

                    <div class="text-start">

                        <div class="row mb-3">
                            <div class="col-6 text-muted">
                                Número do agendamento
                            </div>
                            <div class="col-6 text-end fw-bold">
                                #@Model.Id
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6 text-muted">
                                Cliente
                            </div>
                            <div class="col-6 text-end">
                                @Model.Cliente?.Nome
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6 text-muted">
                                Serviço
                            </div>
                            <div class="col-6 text-end">
                                @Model.Servico?.Nome
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6 text-muted">
                                Profissional
                            </div>
                            <div class="col-6 text-end">
                                @Model.Profissional?.Nome
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6 text-muted">
                                Data
                            </div>
                            <div class="col-6 text-end">
                                @Model.Data.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6 text-muted">
                                Horário
                            </div>
                            <div class="col-6 text-end">
                                @Model.Horario.ToString(@"hh\:mm")
                            </div>
                        </div>

                        <hr />

                        <div class="row mb-3">
                            <div class="col-6 text-muted">
                                Valor do serviço
                            </div>
                            <div class="col-6 text-end fw-bold">
                                @Model.Servico?.Preco.ToString("C2")
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6 text-muted">
                                Sinal (@pagamento?.Percentual%)
                            </div>
                            <div class="col-6 text-end fw-bold">
                                @pagamento?.Valor.ToString("C2")
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6 text-muted">
                                Status do pagamento
                            </div>
                            <div class="col-6 text-end">
                                @if (aprovado)
                                {
                                    <span class="badge bg-success">
                                        Aprovado
                                    </span>
                                }
                                else if (falhou)
                                {
                                    <span class="badge bg-danger">
                                        Não aprovado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pendente
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6 text-muted">
                                Status do agendamento
                            </div>
                            <div class="col-6 text-end">
                                @Model.Status
                            </div>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="d-flex flex-column flex-md-row
                                justify-content-center gap-2">

                        <a asp-controller="AgendamentoCliente"
                           asp-action="MeusAgendamentos"
                           class="btn btn-primary">
                            <i class="bi bi-calendar-check me-1"></i>
                            Meus agendamentos
                        </a>

                        <button type="button"
                                onclick="window.print()"
                                class="btn btn-outline-secondary">
                            <i class="bi bi-printer me-1"></i>
                            Imprimir detalhes
                        </button>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<style>
    @@media print {
        header, nav, footer,
        .btn {
            display: none !important;
        }

        body {
            background: white !important;
        }

        .card {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
        }
    }
</style>