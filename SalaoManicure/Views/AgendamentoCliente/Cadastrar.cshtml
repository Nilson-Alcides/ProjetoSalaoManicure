
@model SalaoManicure.Models.Agendamento

@{
    ViewData["Title"] = "Novo Agendamento";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="container py-4">

    <div class="mb-4">
        <h2>
            <i class="bi bi-calendar-plus me-2"></i>
            Novo Agendamento
        </h2>

        <p class="text-muted">
            Escolha o profissional, o serviço, a data e um horário disponível.
        </p>
    </div>

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Erro"]
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-controller="AgendamentoCliente"
                  asp-action="Cadastrar"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="row g-3">

                    <!-- PROFISSIONAL -->
                    <div class="col-md-6">
                        <label asp-for="ProfissionalId"
                               class="form-label">
                            Profissional
                        </label>

                        <select asp-for="ProfissionalId"
                                asp-items="ViewBag.Profissionais"
                                class="form-select"
                                id="ProfissionalId"
                                required>
                            <option value="">Selecione o profissional</option>
                        </select>

                        <span asp-validation-for="ProfissionalId"
                              class="text-danger"></span>
                    </div>

                    <!-- SERVIÇO -->
                    <div class="col-md-6">
                        <label asp-for="ServicoId"
                               class="form-label">
                            Serviço
                        </label>

                        <select asp-for="ServicoId"
                                asp-items="ViewBag.Servicos"
                                class="form-select"
                                id="ServicoId"
                                required>
                            <option value="">Selecione o serviço</option>
                        </select>

                        <span asp-validation-for="ServicoId"
                              class="text-danger"></span>
                    </div>

                    <!-- DATA -->
                    <div class="col-md-6">
                        <label asp-for="Data"
                               class="form-label">
                            Data do agendamento
                        </label>

                        <input asp-for="Data"
                               type="date"
                               class="form-control"
                               id="Data"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required />

                        <span asp-validation-for="Data"
                              class="text-danger"></span>
                    </div>

                    <!-- HORÁRIO -->
                    <div class="col-md-6">
                        <label asp-for="Horario"
                               class="form-label">
                            Horário disponível
                        </label>

                        <select asp-for="Horario"
                                class="form-select"
                                id="Horario"
                                required
                                disabled>
                            <option value="">
                                Selecione primeiro o profissional e a data
                            </option>
                        </select>

                        <span asp-validation-for="Horario"
                              class="text-danger"></span>

                        <div id="mensagemHorarios"
                             class="form-text">
                            Selecione o profissional e a data para consultar os horários.
                        </div>
                    </div>

                </div>

                <!-- RESUMO DO PAGAMENTO -->
                <div class="card bg-light border-0 mt-4"
                     id="resumoPagamento"
                     style="display:none;">

                    <div class="card-body">

                        <h5 class="mb-3">
                            <i class="bi bi-wallet2 me-2"></i>
                            Resumo do pagamento
                        </h5>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Valor do serviço:</span>
                            <strong id="valorServico">R$ 0,00</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Sinal para reservar (30%):</span>
                            <strong class="text-success"
                                    id="valorSinal">R$ 0,00</strong>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <span>Restante a pagar no salão:</span>
                            <strong id="valorRestante">R$ 0,00</strong>
                        </div>

                        <div class="alert alert-info mt-3 mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            Para confirmar sua reserva, será necessário pagar
                            o sinal de 30% pelo Mercado Pago.
                            O restante será pago diretamente no salão.
                        </div>

                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex flex-wrap gap-2">

                    <button type="submit"
                            class="btn btn-primary"
                            id="btnAgendar">
                        <i class="bi bi-credit-card me-1"></i>
                        Agendar e pagar sinal
                    </button>

                    <a asp-controller="AgendamentoCliente"
                       asp-action="MeusAgendamentos"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Voltar
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const profissionalSelect =
                document.getElementById("ProfissionalId");

            const servicoSelect =
                document.getElementById("ServicoId");

            const dataInput =
                document.getElementById("Data");

            const horarioSelect =
                document.getElementById("Horario");

            const mensagem =
                document.getElementById("mensagemHorarios");

            const btnAgendar =
                document.getElementById("btnAgendar");

            const resumoPagamento =
                document.getElementById("resumoPagamento");

            // Dados dos serviços disponibilizados pelo servidor
            const servicos = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
                                    ((IEnumerable<SalaoManicure.Models.Servico>)ViewBag.ServicosDados)
                                    .Select(s => new
                                    {
                                            id = s.Id,
                                            nome = s.Nome,
                                            preco = s.Preco
                                    })
                            )
                    );

        const formatarMoeda = valor =>
            Number(valor).toLocaleString("pt-BR", {
                style: "currency",
                currency: "BRL"
            });

            // Atualizar resumo financeiro
            function atualizarResumoPagamento() {

                const servicoId = Number(servicoSelect.value);

                const servico = servicos.find(
                    s => s.id === servicoId
                );

                if (!servico) {
                    resumoPagamento.style.display = "none";
                    return;
                }

                const preco = Number(servico.preco);
                const sinal = Math.round((preco * 0.30 + Number.EPSILON) * 100) / 100;
                const restante = Math.round((preco - sinal) * 100) / 100;

                document.getElementById("valorServico").textContent =
                    formatarMoeda(preco);

                document.getElementById("valorSinal").textContent =
                    formatarMoeda(sinal);

                document.getElementById("valorRestante").textContent =
                    formatarMoeda(restante);

                resumoPagamento.style.display = "block";
            }

            servicoSelect.addEventListener(
                "change",
                atualizarResumoPagamento
            );

            atualizarResumoPagamento();

            // Consultar horários disponíveis
            async function carregarHorarios() {

                const profissionalId = profissionalSelect.value;
                const data = dataInput.value;

                horarioSelect.innerHTML = "";

                if (!profissionalId || !data) {

                    horarioSelect.add(
                        new Option(
                            "Selecione primeiro o profissional e a data",
                            ""
                        )
                    );

                    horarioSelect.disabled = true;

                    mensagem.textContent =
                        "Selecione o profissional e a data para consultar os horários.";

                    return;
                }

                horarioSelect.disabled = true;

                horarioSelect.add(
                    new Option("Carregando horários...", "")
                );

                mensagem.textContent =
                    "Consultando os horários disponíveis...";

                try {

                    const url =
                        `/AgendamentoCliente/HorariosDisponiveis` +
                        `?profissionalId=${encodeURIComponent(profissionalId)}` +
                        `&data=${encodeURIComponent(data)}`;

                    const resposta = await fetch(url);

                    if (!resposta.ok) {
                        throw new Error("Falha ao consultar horários.");
                    }

                    const horarios = await resposta.json();

                    horarioSelect.innerHTML = "";

                    horarioSelect.add(
                        new Option("Selecione um horário", "")
                    );

                    if (!horarios || horarios.length === 0) {

                        horarioSelect.add(
                            new Option("Nenhum horário disponível", "")
                        );

                        mensagem.textContent =
                            "Não existem horários disponíveis para esta data e profissional.";

                        horarioSelect.disabled = true;
                        return;
                    }

                    horarios.forEach(function (item) {

                        horarioSelect.add(
                            new Option(item.texto, item.valor)
                        );

                    });

                    horarioSelect.disabled = false;

                    mensagem.textContent =
                        `${horarios.length} horário(s) disponível(is).`;

                } catch (erro) {

                    horarioSelect.innerHTML = "";

                    horarioSelect.add(
                        new Option("Erro ao carregar horários", "")
                    );

                    horarioSelect.disabled = true;

                    mensagem.textContent =
                        "Não foi possível consultar os horários. Tente novamente.";

                    console.error(erro);
                }
            }

            profissionalSelect.addEventListener(
                "change",
                carregarHorarios
            );

            dataInput.addEventListener(
                "change",
                carregarHorarios
            );

            if (profissionalSelect.value && dataInput.value) {
                carregarHorarios();
            }

            // Evitar duplo envio
            document.querySelector("form").addEventListener(
                "submit",
                function (event) {

                    if (horarioSelect.disabled ||
                        !horarioSelect.value) {

                        event.preventDefault();

                        mensagem.textContent =
                            "Selecione um horário disponível antes de continuar.";

                        horarioSelect.focus();
                        return;
                    }

                    if (!servicoSelect.value) {
                        event.preventDefault();
                        servicoSelect.focus();
                        return;
                    }

                    btnAgendar.disabled = true;

                    btnAgendar.innerHTML =
                        '<span class="spinner-border spinner-border-sm me-1"></span>' +
                        'Preparando pagamento...';
                }
            );

        });
    </script>
}
